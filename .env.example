# Host-side local development. Compose sets container service URLs itself.
DATABASE_URL=postgresql://flightshare:flightshare_local@localhost:5432/flightshare
REDIS_URL=redis://localhost:6379
APP_ORIGIN=http://localhost:3000
PORT=3000
BIND_HOST=127.0.0.1

FLIGHT_PROVIDER=mock
# Optional RapidAPI key with an active AeroDataBox subscription. Keep the real value in .env only.
AERODATABOX_RAPIDAPI_KEY=
ALLOW_INSECURE_HTTP=true
TRUST_PROXY=false
ALLOW_DEMO_SEED=false
