generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationStatus {
  SELF_REPORTED
  MOCK
  VERIFIED
}

enum Transportation {
  NONE
  CAB_SHARE
  PUBLIC_TRANSIT
  OWN_RIDE
}

model User {
  id            String   @id @default(uuid())
  email         String?  @unique
  emailVerified DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile          PassengerProfile?
  sessions         Session[]
  memberships      FlightMembership[]
  verifications    VerificationRecord[]
  conversationsOne Conversation[] @relation("ParticipantOne")
  conversationsTwo Conversation[] @relation("ParticipantTwo")
  messages         Message[]
  flightMessages   FlightGroupMessage[]
  rideConfirmations RideConfirmation[]
  notifications    Notification[]
  blocksMade       UserBlock[] @relation("Blocker")
  blocksReceived   UserBlock[] @relation("Blocked")
  reportsMade      UserReport[] @relation("Reporter")
  reportsReceived  UserReport[] @relation("Reported")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PassengerProfile {
  id                    String         @id @default(uuid())
  userId                String         @unique
  displayName           String
  isAnonymous           Boolean        @default(false)
  showBaggage           Boolean        @default(true)
  showTravelPreferences Boolean        @default(true)
  showFlyer             Boolean        @default(true)
  transportation        Transportation @default(NONE)
  companionship         Boolean        @default(false)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Flight {
  id               String   @id @default(uuid())
  instanceKey      String   @unique
  airline          String
  flightNumber     String
  departureAirport String
  arrivalAirport   String
  departureDate    DateTime @db.Date
  departureTime    String?
  externalFlightId String?
  status           String?
  createdAt        DateTime @default(now())

  memberships   FlightMembership[]
  verifications VerificationRecord[]
  conversationContextsOne ConversationContext[] @relation("ContextFlightOne")
  conversationContextsTwo ConversationContext[] @relation("ContextFlightTwo")
  groupMessages FlightGroupMessage[]

  @@index([departureDate])
  @@index([departureAirport, departureDate])
  @@index([airline, flightNumber, departureDate])
  @@unique([airline, externalFlightId])
}

model FlightMembership {
  id                    String             @id @default(uuid())
  flightId              String
  userId                String
  alias                 String
  baggageAllowance      Decimal            @db.Decimal(6, 2)
  expectedBaggageWeight  Decimal            @db.Decimal(6, 2)
  cabinBaggage           String?
  baggageReported       Boolean            @default(true)
  partySize              Int                @default(1)
  verificationStatus     VerificationStatus
  joinedAt              DateTime           @default(now())
  isActive              Boolean            @default(true)
  flight                Flight             @relation(fields: [flightId], references: [id], onDelete: Cascade)
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  cabListings           CabListing[]
  cabRequests           CabRequest[]
  baggageSent           BaggageRequest[] @relation("BaggageSender")
  baggageReceived       BaggageRequest[] @relation("BaggageRecipient")
  baggageReservation    BaggageReservation?

  @@unique([flightId, userId])
  @@unique([id, flightId])
  @@unique([flightId, alias])
  @@index([flightId, isActive, joinedAt])
  @@index([userId, isActive])
}

enum BaggageRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  CANCELLED
  ENDED
}

model BaggageRequest {
  id                    String               @id @default(uuid())
  flightId              String
  senderMembershipId    String
  recipientMembershipId String
  status                BaggageRequestStatus @default(PENDING)
  conversationId        String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  senderMembership      FlightMembership     @relation("BaggageSender", fields: [senderMembershipId, flightId], references: [id, flightId], onDelete: Cascade)
  recipientMembership   FlightMembership     @relation("BaggageRecipient", fields: [recipientMembershipId, flightId], references: [id, flightId], onDelete: Cascade)
  conversation          Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  reservations          BaggageReservation[]

  @@index([senderMembershipId, status])
  @@index([recipientMembershipId, status])
  @@index([conversationId])
}

// One accepted baggage match per flight membership, irrespective of request direction.
model BaggageReservation {
  membershipId String           @id
  requestId    String
  membership   FlightMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  request      BaggageRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

enum CabRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  CLOSED
}

model CabListing {
  id               String           @id @default(uuid())
  hostMembershipId String
  pickupArea       String
  freeSeats        Int
  closedAt         DateTime?
  createdAt        DateTime         @default(now())
  hostMembership   FlightMembership @relation(fields: [hostMembershipId], references: [id], onDelete: Cascade)
  requests         CabRequest[]

  @@index([hostMembershipId])
}

model CabRequest {
  id                String           @id @default(uuid())
  listingId         String
  riderMembershipId String
  seats             Int
  window            Int
  status            CabRequestStatus @default(PENDING)
  conversationId    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  listing           CabListing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  riderMembership   FlightMembership @relation(fields: [riderMembershipId], references: [id], onDelete: Cascade)
  conversation      Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([listingId, riderMembershipId])
  @@index([listingId, status])
  @@index([riderMembershipId, createdAt])
  @@index([conversationId])
}

model Conversation {
  id               String   @id @default(uuid())
  participantOneId String
  participantTwoId String
  createdAt        DateTime @default(now())
  participantOne   User     @relation("ParticipantOne", fields: [participantOneId], references: [id], onDelete: Cascade)
  participantTwo   User     @relation("ParticipantTwo", fields: [participantTwoId], references: [id], onDelete: Cascade)
  messages         Message[]
  baggageRequests  BaggageRequest[]
  cabRequests      CabRequest[]
  contexts         ConversationContext[]

  @@unique([participantOneId, participantTwoId])
  @@index([participantTwoId])
}

model ConversationContext {
  id               String @id @default(uuid())
  conversationId   String
  flightOneId      String
  flightTwoId      String
  ride             Boolean @default(false)
  createdAt        DateTime @default(now())
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  flightOne        Flight @relation("ContextFlightOne", fields: [flightOneId], references: [id], onDelete: Cascade)
  flightTwo        Flight @relation("ContextFlightTwo", fields: [flightTwoId], references: [id], onDelete: Cascade)
  rideConfirmations RideConfirmation[]

  @@unique([conversationId, flightOneId, flightTwoId])
  @@index([flightOneId])
  @@index([flightTwoId])
}

model FlightGroupMessage {
  id        String   @id @default(uuid())
  flightId  String
  senderId  String
  clientId  String
  content   String
  createdAt DateTime @default(now())
  flight    Flight   @relation(fields: [flightId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([flightId, senderId, clientId])
  @@index([flightId, createdAt, id])
  @@index([senderId])
}

model RideConfirmation {
  contextId      String
  userId         String
  createdAt      DateTime @default(now())
  context        ConversationContext @relation(fields: [contextId], references: [id], onDelete: Cascade)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([contextId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  clientId       String
  content        String
  createdAt      DateTime @default(now())
  readAt         DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([conversationId, senderId, clientId])
  @@index([conversationId, createdAt, id])
  @@index([conversationId, readAt, senderId])
  @@index([senderId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt, id])
  @@index([userId, readAt])
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model UserReport {
  id             String   @id @default(uuid())
  reporterId     String
  reportedUserId String
  reason         String
  description    String?
  createdAt      DateTime @default(now())
  status         String   @default("OPEN")
  reporter       User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported       User     @relation("Reported", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reporterId, createdAt])
  @@index([reportedUserId])
  @@index([status, createdAt])
}

model VerificationRecord {
  id                 String             @id @default(uuid())
  userId             String
  flightId           String
  verificationMethod String
  verificationStatus VerificationStatus
  verifiedAt         DateTime?
  expiresAt          DateTime?
  user               User @relation(fields: [userId], references: [id], onDelete: Cascade)
  flight             Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@unique([userId, flightId])
  @@index([flightId])
}